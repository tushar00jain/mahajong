{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "git config --global url.\"https://x-access-token:${GH_SUBMODULE_TOKEN}@github.com/\".insteadOf \"https://github.com/\" && npm install && npm update ui",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai, noarchive"
        }
      ]
    }
  ]
}
